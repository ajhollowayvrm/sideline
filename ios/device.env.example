# Where `npm run ios:deploy` sends the build. Copy to `ios/device.env` and fill both in.
# `device.env` is gitignored — the team ID and the device UDID are yours, not the repo's.

# Apple Developer team ID. Xcode → Settings → Accounts → your Apple ID → the ID beside the team.
TEAM=XXXXXXXXXX

# The paired iPhone. Find it with:  xcrun devicectl list devices
UDID=00000000-0000-0000-0000-000000000000
